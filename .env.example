POSTGRES_DB=Course_agent
POSTGRES_USER=course_app
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+asyncpg://course_app:change_this_password@localhost:5432/Course_agent
PAYMENT_GATEWAY_MODE=demo
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=groq/qwen/qwen3.8-27b

# Gmail IMAP settings (only needed if you add inbound email reading)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=your-gmail-address@gmail.com
IMAP_PASSWORD=replace_with_gmail_app_password
MAX_EMAILS=10
MAX_CHARS_PER_EMAIL=2000

# Gmail SMTP settings for outbound refund notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
